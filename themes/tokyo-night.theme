# Tokyo Night — Terminal Setup renk paleti
# Biçim: ANAHTAR="#RRGGBB". COLOR0-7 normal, COLOR8-15 parlak renkler.
NAME="Tokyo Night"
DESC="Modern mavi ve mor gece tonları"
BACKGROUND="#1A1B26"
FOREGROUND="#C0CAF5"
CURSOR="#C0CAF5"
SELECTION_BG="#33467C"
SELECTION_FG="#C0CAF5"
# tmux durum çubuğu vurgusu ve bölme kenarlığı
ACCENT="#7AA2F7"
# bat ve delta söz dizimi teması (yerleşik karşılığı yoksa: ansi)
BAT_THEME="ansi"
