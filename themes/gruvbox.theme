# Gruvbox — Terminal Setup renk paleti
# Biçim: ANAHTAR="#RRGGBB". COLOR0-7 normal, COLOR8-15 parlak renkler.
NAME="Gruvbox"
DESC="Retro ve sıcak tonlar"
BACKGROUND="#282828"
FOREGROUND="#EBDBB2"
CURSOR="#EBDBB2"
SELECTION_BG="#504945"
SELECTION_FG="#EBDBB2"
# tmux durum çubuğu vurgusu ve bölme kenarlığı
ACCENT="#FABD2F"
BORDER="#504945"
# bat ve delta söz dizimi teması (yerleşik karşılığı yoksa: ansi)
BAT_THEME="gruvbox-dark"
# açık ya da koyu; PAIR: diğer tondaki eşi (Ptyxis sistemin tonunu izler)
# Kişilik (styles/): prompt, kenar ve araçların biçimi
STYLE="retro"
VARIANT="dark"
PAIR="gruvbox-light"
COLOR0="#282828"
COLOR1="#CC241D"
COLOR2="#98971A"
COLOR3="#D79921"
COLOR4="#458588"
COLOR5="#B16286"
COLOR6="#689D6A"
COLOR7="#A89984"
COLOR8="#928374"
COLOR9="#FB4934"
COLOR10="#B8BB26"
COLOR11="#FABD2F"
COLOR12="#83A598"
COLOR13="#D3869B"
COLOR14="#8EC07C"
COLOR15="#EBDBB2"
