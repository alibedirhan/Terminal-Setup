# Dracula — Terminal Setup renk paleti
# Biçim: ANAHTAR="#RRGGBB". COLOR0-7 normal, COLOR8-15 parlak renkler.
NAME="Dracula"
DESC="Gotik ve şık; mor ve pembe vurgular"
BACKGROUND="#282A36"
FOREGROUND="#F8F8F2"
CURSOR="#F8F8F2"
SELECTION_BG="#44475A"
SELECTION_FG="#FFFFFF"
# tmux durum çubuğu vurgusu ve bölme kenarlığı
ACCENT="#BD93F9"
BORDER="#6272A4"
# bat ve delta söz dizimi teması (yerleşik karşılığı yoksa: ansi)
BAT_THEME="Dracula"
# açık ya da koyu; PAIR: diğer tondaki eşi (Ptyxis sistemin tonunu izler)
VARIANT="dark"
COLOR0="#21222C"
COLOR1="#FF5555"
COLOR2="#50FA7B"
COLOR3="#F1FA8C"
COLOR4="#BD93F9"
COLOR5="#FF79C6"
COLOR6="#8BE9FD"
COLOR7="#F8F8F2"
COLOR8="#6272A4"
COLOR9="#FF6E6E"
COLOR10="#69FF94"
COLOR11="#FFFFA5"
COLOR12="#D6ACFF"
COLOR13="#FF92DF"
COLOR14="#A4FFFF"
COLOR15="#FFFFFF"
