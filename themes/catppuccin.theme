# Catppuccin Mocha — Terminal Setup renk paleti
# Biçim: ANAHTAR="#RRGGBB". COLOR0-7 normal, COLOR8-15 parlak renkler.
NAME="Catppuccin Mocha"
DESC="Pastel renkler, koyu zemin"
BACKGROUND="#1E1E2E"
FOREGROUND="#CDD6F4"
CURSOR="#F5E0DC"
SELECTION_BG="#585B70"
SELECTION_FG="#CDD6F4"
# tmux durum çubuğu vurgusu ve bölme kenarlığı
ACCENT="#89B4FA"
# bat ve delta söz dizimi teması (yerleşik karşılığı yoksa: ansi)
BAT_THEME="ansi"
