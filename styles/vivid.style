# Terminal Setup kişiliği: temanın biçimi (renkler temadan gelir)
# Biçim: ANAHTAR="değer". Değerler lib/styles.sh içinde denetlenir.
NAME="Vivid"
DESC="Dolgu renkli ok etiketler, kalın çerçeve, λ"
PROMPT_SYMBOL="λ"
PROMPT_LAYOUT="two-line"
SEGMENTS="powerline"
BORDER="heavy"
TITLE_CASE="normal"
TEXT_CASE="normal"
SEPARATOR="·"
ICONS="on"
DATE_FORMAT="+%d.%m.%y %H:%M"
BAT_STYLE="numbers,grid,header"
GIT_SYMBOLS="unicode"
