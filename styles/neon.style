# Terminal Setup kişiliği: temanın biçimi (renkler temadan gelir)
# Biçim: ANAHTAR="değer". Değerler lib/styles.sh içinde denetlenir.
NAME="Neon"
DESC="Çift çizgili çerçeve, ▸ ayırıcılar, ▶"
PROMPT_SYMBOL="▶"
PROMPT_LAYOUT="two-line"
SEGMENTS="arrows"
BORDER="double"
TITLE_CASE="upper"
TEXT_CASE="normal"
SEPARATOR="▸"
ICONS="on"
DATE_FORMAT="+%d.%m.%y %H:%M"
BAT_STYLE="numbers,grid"
GIT_SYMBOLS="unicode"
